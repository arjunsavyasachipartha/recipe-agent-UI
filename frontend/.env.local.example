# Example environment for the BornBhukkad demo frontend.
# Copy to `.env.local` (git-ignored) and fill in real values. NEVER commit secrets,
# and NEVER prefix any of these with NEXT_PUBLIC_ — they are read on the server only
# and must never reach the browser.

# Postgres connection for the frontend's own account/session DB
# (matches frontend/docker-compose.yml — host port 5433 in local dev).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/bornbhukkad

# ── Recipe Creation Agent backend ─────────────────────────────────────────
# Base URL of the deployed FastAPI backend that issues per-restaurant API keys.
RECIPE_AGENT_API_URL=https://your-backend-host.example

# Admin key for the backend. Read ONLY server-side (in /api/agent/register) to
# provision a restaurant's per-account API key. Every browser-facing call goes
# through the BFF proxy (/api/agent/[...path]) with the restaurant key injected
# server-side, so this admin key is never exposed to the client.
RECIPE_AGENT_ADMIN_KEY=replace-with-admin-key
